#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Local development: load values from an env file that was created after
# Docker Compose started (see the setup service). Values already set win.
if [ -n "${AUTOLOAD_ENV_FILE:-}" ] && [ -f "${AUTOLOAD_ENV_FILE}" ]; then
    while IFS='=' read -r key value || [ -n "${key}" ]; do
        [[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        if [ -z "${!key+x}" ]; then
            export "${key}=${value%$'\r'}"
        fi
    done < "${AUTOLOAD_ENV_FILE}"
fi

if [ -z "${POSTGRES_USER}" ]; then
    base_postgres_image_default_user='postgres'
    export POSTGRES_USER="${base_postgres_image_default_user}"
fi
export DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

wait-for-it "${POSTGRES_HOST}:${POSTGRES_PORT}" -t 30

>&2 echo 'PostgreSQL is available'

exec "$@"
