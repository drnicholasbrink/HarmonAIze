#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python /app/manage.py collectstatic --noinput
python /app/manage.py migrate --noinput

# Auto-load geolocation reference data in background (don't block server startup)
(python /app/manage.py load_hdx_data || true) &
(python /app/manage.py load_validation_data || true) &
# Download admin boundary reference dataset from Google Drive if not already present
(python /app/manage.py download_admin_boundary_data || true) &
# Process admin boundaries GeoJSON (only runs if not already processed)
(python /app/manage.py process_admin_boundaries --simplify || true) &
# Pre-build admin boundary index for fast geocoding (cached in Redis)
(python /app/manage.py build_boundary_index || true) &

exec /usr/local/bin/gunicorn config.asgi --bind 0.0.0.0:5000 --chdir=/app -k uvicorn_worker.UvicornWorker
