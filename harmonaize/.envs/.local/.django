# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
ANALYSIS_ENABLED=false
IPYTHONDIR=/app/.ipython
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=replace-with-local-flower-user
CELERY_FLOWER_PASSWORD=replace-with-local-flower-password

# Postgres
DATABASE_URL=postgres://replace-with-local-postgres-user:replace-with-local-postgres-password@postgres:5432/harmonaize

# Mapbox
MAPBOX_ACCESS_TOKEN=replace-with-local-mapbox-token
# Google Earth Engine
GOOGLE_APPLICATION_CREDENTIALS=/app/.envs/.local/gee-credentials.json

# OpenAI
# Required for embedding functionality in production
OPENAI_API_KEY=replace-with-local-openai-api-key
# Optional: Override default embedding settings (uncomment if needed)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# EMBEDDING_CHUNK_TOKENS=8000
# EMBEDDING_CHUNK_OVERLAP=50

# Gemini
# GEMINI_API_KEY=replace-with-local-gemini-api-key
